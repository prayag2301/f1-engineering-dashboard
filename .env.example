# Run python3 scripts/configure.py to generate real local credentials.
# Existing databases must retain their existing POSTGRES_PASSWORD.
ADMIN_TOKEN=
SESSION_SECRET=
POSTGRES_PASSWORD=
WEB_PORT=3000

# Optional direct host development, after exposing db/redis in a local Compose override:
# DATABASE_URL=postgresql://f1user:YOUR_PASSWORD@localhost:5432/f1dashboard
# REDIS_URL=redis://localhost:6379/0
# BACKEND_URL=http://localhost:8000
# RENDER_SAMPLES=128
# BUILD_TIMEOUT_SECONDS=7200
# ENABLE_DEMO_DATA=false
