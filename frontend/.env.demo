# Used for the static GitHub Pages demo build.
# Loaded automatically when NODE_ENV=production AND this filename is selected.
# In CI we just set these via env: in the workflow, but this file lets you
# build the demo locally with: `npm run build` after `cp .env.demo .env.production.local`
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_BASE_PATH=/f1-engineering-dashboard
