{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upgrade.schema.json",
  "title": "Upgrade",
  "type": "object",
  "required": ["id", "team_id", "race_id", "component_id", "category", "description", "confidence", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "team_id": { "type": "string", "format": "uuid" },
    "race_id": { "type": "string", "format": "uuid" },
    "component_id": { "type": "string", "format": "uuid" },
    "category": { "$ref": "enums/upgrade-category.schema.json" },
    "description": { "type": "string" },
    "technical_detail": { "type": ["string", "null"] },
    "expected_effect": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "aero_reasoning": { "type": ["string", "null"] },
    "mechanical_reasoning": { "type": ["string", "null"] },
    "performance_hypothesis": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "team": {
      "oneOf": [
        { "$ref": "team.schema.json" },
        { "type": "null" }
      ]
    },
    "race": {
      "oneOf": [
        { "$ref": "race.schema.json" },
        { "type": "null" }
      ]
    },
    "component": {
      "oneOf": [
        { "$ref": "component.schema.json" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
