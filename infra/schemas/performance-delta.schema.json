{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "performance-delta.schema.json",
  "title": "PerformanceDelta",
  "type": "object",
  "required": ["id", "team_id", "race_id", "delta_fp1_to_quali", "delta_quali_to_race", "delta_race_over_race", "upgrade_efficiency_score", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "team_id": { "type": "string", "format": "uuid" },
    "race_id": { "type": "string", "format": "uuid" },
    "fp1_time": { "type": ["number", "null"] },
    "fp2_time": { "type": ["number", "null"] },
    "fp3_time": { "type": ["number", "null"] },
    "quali_time": { "type": ["number", "null"] },
    "race_best_lap": { "type": ["number", "null"] },
    "delta_fp1_to_quali": { "type": "number" },
    "delta_quali_to_race": { "type": "number" },
    "delta_race_over_race": { "type": "number" },
    "upgrade_efficiency_score": { "type": "number" },
    "notes": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
