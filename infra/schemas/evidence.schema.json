{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": ["id", "upgrade_id", "source", "license", "credibility_score", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "upgrade_id": { "type": "string", "format": "uuid" },
    "source": { "type": "string" },
    "license": { "type": "string", "default": "unknown" },
    "credibility_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "media_path": { "type": ["string", "null"] },
    "article_path": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
