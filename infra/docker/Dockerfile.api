FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY apps/api/backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Source code (including alembic/ and alembic.ini) is mounted at runtime:
#   ./apps/api/backend:/app/backend
# so no COPY of source needed here.

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
